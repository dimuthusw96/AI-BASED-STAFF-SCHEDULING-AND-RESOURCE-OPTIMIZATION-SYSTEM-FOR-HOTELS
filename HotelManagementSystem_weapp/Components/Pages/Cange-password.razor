@page "/change-password/{TargetUser}"
@using HotelManagementSystem_weapp.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<div class="password-container d-flex align-items-center justify-content-center">
    <div class="password-card shadow-lg border-0">
        <div class="password-header bg-success text-white p-4 text-center">
            <div class="icon-circle mb-3 mx-auto shadow-sm">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h3 class="fw-bold mb-1">Secure Your Account</h3>
            <p class="small opacity-75 mb-0">Setting up credentials for: <strong>@TargetUser</strong></p>
        </div>

        <div class="card-body p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <p class="text-muted small">Choose a strong password to complete your account setup.</p>
            </div>

            <div class="form-group mb-4">
                <label class="form-label small fw-bold text-muted text-uppercase mb-1">New Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-key text-success"></i></span>
                    <input type="password" @bind="newPassword"
                           class="form-control bg-light border-0 shadow-none"
                           placeholder="Minimum 8 characters" />
                </div>
            </div>

            <button class="btn btn-success w-100 py-3 fw-bold shadow-sm mb-2" @onclick="UpdatePassword">
                Update & Continue <i class="bi bi-arrow-right-circle ms-2"></i>
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger border-0 small mt-3 d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                </div>
            }

            <div class="mt-4 text-center">
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>
                    Your session is encrypted and secure.
                </small>
            </div>
        </div>
    </div>
</div>
@code {
    [Parameter] public string? TargetUser { get; set; }
    private string newPassword = "";
    private string errorMessage = "";

    private async Task UpdatePassword()
    {
        try
        {
            if (string.IsNullOrEmpty(TargetUser))
            {
                errorMessage = "User identification failed. Please log in again.";
                return;
            }

            // 1. Fetch the user including their Role from the DB
            var user = await _db.ApplicationUsers.FirstOrDefaultAsync(u => u.Username == TargetUser);

            if (user != null)
            {
                // 2. Securely hash and update the password
                user.PasswordHash = BCrypt.Net.BCrypt.HashPassword(newPassword);
                user.IsPasswordResetRequired = false;

                _db.ApplicationUsers.Update(user);
                await _db.SaveChangesAsync(); // Save to SQL Database

                // 3. Log the user in officially using the persistence-ready method
                var customAuthProvider = (CustomAuthStateProvider)AuthStateProvider;

                var session = new UserSession
                {
                    UserName = user.FullName,
                    Role = user.Role
                };

                // This ensures the sidebar permissions and "Welcome" name persist after redirect
                await customAuthProvider.UpdateAuthenticationState(session);

                // 4. Redirect to the Home page
                Nav.NavigateTo("/");
            }
            else
            {
                errorMessage = "Account not found in the system.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
    }
}