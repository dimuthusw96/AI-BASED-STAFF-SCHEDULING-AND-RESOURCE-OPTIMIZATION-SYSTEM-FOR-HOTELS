@page "/staffmanagement"
@using HotelManagementSystem_weapp.Data
@using HotelManagementSystem_weapp.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<style>
    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .app-container {
        padding: 40px;
        width: 100%
    }

    /* GLASS HEADER */
    .glass-header {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px 30px;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.18);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
</style>

<div class="container-fluid py-4">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm mb-4 fade-out-animation">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(successmessage))
    {
        <div class="alert alert-success shadow-sm mb-4 fade-out-animation">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @successmessage
        </div>
    }

    <div class="container-fluid py-4">
        <div class="glass-header">
            <div>
            <h2 class="fw-bold text-dark mb-0">Staff Directory</h2>
            <p class="text-muted small">Manage hotel personnel and payroll rates</p>
            </div>
        </div>
        <button class="btn btn-primary shadow-sm px-4" @onclick="() => OpenModal()">
            <i class="bi bi-person-plus-fill me-2"></i> Add New Staff
        </button>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Full Name</th>
                            <th>Role</th>
                            <th>Hourly Rate</th>
                            <th>Max Hours</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var staff in staffList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@staff.StaffID</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="initials-circle me-2">@GetInitials(staff.FullName)</div>
                                        <span>@staff.FullName</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-info-subtle text-info rounded-pill px-3">@staff.Role</span></td>
                                <td>$@staff.HourlyRate.ToString("F2")</td>
                                <td>@staff.MaxHoursPerWeek hrs</td>
                                <td>
                                    <span class="@(staff.IsActive ? "text-success" : "text-danger")">
                                        <i class="bi bi-circle-fill me-1 small"></i> @(staff.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-secondary border-0 me-1" @onclick="() => OpenModal(staff)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => DeleteStaff(staff.StaffID)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 15px;">
                <div class="modal-header border-0 p-4">
                    <h5 class="fw-bold">@(editingStaff.StaffID == 0 ? "Register New Staff" : "Update Staff Details")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4 pt-0">
                    <EditForm Model="editingStaff" OnValidSubmit="SaveStaff">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold text-muted">Full Name</label>
                                <InputText @bind-Value="editingStaff.FullName" class="form-control bg-light border-0" />
                            </div>
                            @* <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Username</label>
                                <InputText @bind-Value="editingStaff.Username" class="form-control bg-light border-0" />
                            </div> *@
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Role</label>
                                <InputSelect @bind-Value="editingStaff.Role" class="form-select bg-light border-0">
                                    <option value="">Select Role</option>
                                    <option value="Housekeeping">Housekeeping</option>
                                    <option value="FrontDesk">Front Desk</option>
                                    <option value="Kitchen">Kitchen</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Hourly Rate ($)</label>
                                <InputNumber @bind-Value="editingStaff.HourlyRate" class="form-control bg-light border-0" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Max Hours</label>
                                <InputNumber @bind-Value="editingStaff.MaxHoursPerWeek" class="form-control bg-light border-0" />
                            </div>
                            <div class="col-12 mt-3">
                                <div class="form-check form-switch">
                                    <InputCheckbox @bind-Value="editingStaff.IsActive" class="form-check-input" id="activeSwitch" />
                                    <label class="form-check-label small fw-bold text-muted" for="activeSwitch">Active Account</label>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-3 fw-bold shadow-sm">Save Changes</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .initials-circle {
        width: 32px;
        height: 32px;
        background: #e9ecef;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
        color: #495057;
    }

    .fade-out-animation {
        animation: fadeOut 5.5s forwards;
    }

    keyframes fadeOut {
        0% {
            opacity: 1;
        }

        80% {
            opacity: 1;
        }

        100% {
            opacity: 0;
        }
    }
</style>

@code {
    private List<Staff> staffList = new();
    private Staff editingStaff = new();
    private bool showModal = false;
    private string? errorMessage;
    private string? successmessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadStaff();
    }

    private async Task LoadStaff()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        staffList = await db.Staff.AsNoTracking().ToListAsync();
    }

    private void OpenModal(Staff? staff = null)
    {
        errorMessage = null;
        if (staff != null)
        {
            // Deep copy to prevent UI state pollution
            editingStaff = new Staff
            {
                StaffID = staff.StaffID,
                FullName = staff.FullName,
                
                Role = staff.Role,
                HourlyRate = staff.HourlyRate,
                MaxHoursPerWeek = staff.MaxHoursPerWeek,
                IsActive = staff.IsActive
               
               
            };
        }
        else
        {
            editingStaff = new Staff { IsActive = true };
        }
        showModal = true;
    }

    private async Task SaveStaff()
    {
        try
        {
            // 1. Open a fresh context specifically for the Save operation
            using (var db = await DbFactory.CreateDbContextAsync())
            {
                if (editingStaff.StaffID == 0)
                {
                    db.Staff.Add(editingStaff);
                }
                else
                {
                    // Explicitly attach and mark as modified to avoid tracking conflicts
                    db.Entry(editingStaff).State = EntityState.Modified;
                }

                // 2. Await the save. The connection stays busy until this is done.
                await db.SaveChangesAsync();
            }
            // 3. The 'using' block ends here, closing the connection and the DataReader.

            // 4. NOW it is safe to load the staff list again.
            await LoadStaff();

            CloseModal();
            string message = editingStaff.StaffID == 0
    ? "Staff member Created!"
    : "Staff member Updated!";

            await ShowsuccessWithTimeout(message);
        }
        catch (Exception ex)
        {
            // Use your auto-hide helper to show the error
            await ShowErrorWithTimeout($"Database Error: {ex.Message}");
        }
    }

    private async Task DeleteStaff(int id)
    {
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();
            var staff = await db.Staff.FindAsync(id);
            if (staff != null)
            {
                db.Staff.Remove(staff);
                await db.SaveChangesAsync();
                await LoadStaff();
            }
            
            await ShowsuccessWithTimeout($"Staff member Deleted!");
        }
        catch (Exception ex)
        {
         await ShowsuccessWithTimeout($"Delete Failed: {ex.Message}");
        }
    }

    private void CloseModal() => showModal = false;

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : $"{parts[0][0]}".ToUpper();
    }
    private async Task ShowErrorWithTimeout(string message)
    {
        errorMessage = message;
        StateHasChanged(); // Force the UI to show the error

        // Wait for 5 seconds
        await Task.Delay(5000);

        errorMessage = string.Empty;
        StateHasChanged(); // Force the UI to hide the error
    }
    private async Task ShowsuccessWithTimeout(string message)
    {
        successmessage = message;
        StateHasChanged(); // Force the UI to show the error

        // Wait for 5 seconds
        await Task.Delay(5000);

        successmessage = string.Empty;
        StateHasChanged(); // Force the UI to hide the error
    }
}