@page "/login"
@using HotelManagementSystem_weapp.Data
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<div class="login-container d-flex align-items-center justify-content-center">
    <div class="login-card shadow-lg">
        <div class="row g-0 h-100">
            <div class="col-md-5 d-none d-md-flex flex-column justify-content-center align-items-center bg-primary text-white p-4">
                <i class="bi bi-building-fill-check mb-3" style="font-size: 4rem;"></i>
                <h2 class="fw-bold">Hotel Pro</h2>
                <p class="text-center small px-3">Advanced Resource & Roster Management System</p>
                <div class="mt-4 border-top pt-3 w-100 text-center opacity-75">
                    <small>DSW</small>
                </div>
            </div>

            <div class="col-md-7 bg-white p-5 d-flex flex-column justify-content-center">
                <div class="text-center mb-4 d-md-none">
                    <h3 class="fw-bold text-primary">Hotel Pro RMS</h3>
                </div>

                <h4 class="fw-bold mb-1 text-dark">Welcome back</h4>
                <p class="text-muted small mb-4">Please enter your details to sign in</p>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control bg-light border-0 shadow-none" id="username" placeholder="Username" @bind="username" />
                    <label for="username" class="text-muted">Username</label>
                </div>

                <div class="form-floating mb-4">
                    <input type="password" class="form-control bg-light border-0 shadow-none" id="password" placeholder="Password" @bind="password" />
                    <label for="password" class="text-muted">Password</label>
                </div>

                <button class="btn btn-primary w-100 py-3 fw-bold shadow-sm" @onclick="HandleLogin">
                    Sign In <i class="bi bi-arrow-right ms-2"></i>
                </button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger border-0 mt-4 small d-flex align-items-center shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                    </div>
                }
            </div>
        </div>
    </div>
</div>



@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";

    [Parameter][SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        try
        {
            // 1. Fetch user from SQL DB
            var user = await _db.ApplicationUsers.FirstOrDefaultAsync(u => u.Username == username);

            // 2. Verify Password using BCrypt
            if (user != null && BCrypt.Net.BCrypt.Verify(password, user.PasswordHash))
            {
                // 3. Get the Custom State Provider
                var customAuthProvider = (CustomAuthStateProvider)AuthStateProvider;

                // 4. Create the session object
                var session = new UserSession
                {
                    UserName = user.FullName,
                    Role = user.Role
                };

                // 5. Update state (Saves to ProtectedSessionStorage)
                await customAuthProvider.UpdateAuthenticationState(session);

                // 6. Navigation Logic
                if (user.IsPasswordResetRequired)
                {
                    // Always force password change if required
                    Nav.NavigateTo($"/change-password/{Uri.EscapeDataString(user.Username)}");
                }
                else if (!string.IsNullOrEmpty(ReturnUrl))
                {
                    // Send them back to the specific page they were trying to access
                    Nav.NavigateTo(ReturnUrl);
                }
                else
                {
                    // Default to Dashboard
                    Nav.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Invalid username or password.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "A database error occurred. Please try again later.";
            // For debugging: Console.WriteLine(ex.Message);
        }
    }
}