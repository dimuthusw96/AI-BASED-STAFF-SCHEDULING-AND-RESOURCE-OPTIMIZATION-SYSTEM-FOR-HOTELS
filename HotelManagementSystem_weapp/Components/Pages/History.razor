@page "/history"
@using System.Text.Json.Serialization
@inject IHttpClientFactory ClientFactory
@inject NavigationManager NavManager
@rendermode InteractiveServer

<style>
    /* --- FORCE SIDEBAR WIDE --- */
    ::deep .sidebar {
        width: 250px !important;
        display: block !important;
    }

    ::deep .nav-link span {
        display: inline !important;
    }

    /* --- TABLE STYLING --- */
    .table-container {
        overflow-x: auto;
        background: white;
        border-radius: 12px;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
    }

        .custom-table th {
            background: #f8f9fe;
            color: #8898aa;
            font-size: 0.8rem;
            padding: 15px;
            text-align: left;
            cursor: pointer;
            border-bottom: 2px solid #edf2f9;
        }

        .custom-table td {
            padding: 15px;
            border-bottom: 1px solid #edf2f9;
            color: #525f7f;
        }

    /* --- PAGINATION CONTROLS --- */
    .pagination-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
    }

    .page-btn {
        border: 1px solid #dee2e6;
        background: white;
        padding: 5px 12px;
        border-radius: 5px;
        margin: 0 2px;
        transition: 0.2s;
    }

        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .page-btn.active {
            background: #5e72e4;
            color: white;
            border-color: #5e72e4;
        }

    /* --- SEARCH BAR --- */
    .filter-input {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        padding: 8px 15px;
        width: 300px;
        margin-bottom: 20px;
        outline: none;
    }

    .glass-header {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px 30px;
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.18);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }
</style>

<div class="app-container">
    <div class="glass-header">
        <h2 style="font-weight:800; color:#32325d;">Prediction History</h2>
        <input type="text" class="filter-input" placeholder="Search by status (High, Normal)..."
               @bind="searchTerm" @bind:event="oninput" />
    </div>

    <div class="table-card">
        @if (isLoading)
        {
            <p>Loading...</p>
        }
        else
        {
            <div class="table-container">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th @onclick='() => Sort("Date")'>Date ↑↓</th>
                            <th @onclick='() => Sort("Guests")'>Guests ↑↓</th>
                            <th>Demand</th>
                            <th style="text-align:right">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in PagedForecasts)
                        {
                            <tr>
                                <td>@item.ForecastDate.ToString("MMM dd, yyyy")</td>
                                <td>@item.OccupancyCount</td>
                                <td>
                                    <span class="badge-soft @(GetBadgeClass(item.Status))">@item.Status</span>
                                </td>
                                <td style="text-align:right">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewRoster(item.ForecastDate)">View Roster</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination-wrapper">
                <span class="text-muted small">Showing @(((currentPage - 1) * pageSize) + 1) to @(Math.Min(currentPage * pageSize, FilteredForecasts.Count())) of @FilteredForecasts.Count() entries</span>
                <div>
                    <button class="page-btn" disabled="@(currentPage == 1)" @onclick="(() => currentPage--)">Prev</button>
                    @for (int i = 1; i <= TotalPages; i++)
                    {
                        var pageNum = i;
                        <button class="page-btn @(currentPage == pageNum ? "active" : "")" @onclick="(() => currentPage = pageNum)">@pageNum</button>
                    }
                    <button class="page-btn" disabled="@(currentPage == TotalPages)" @onclick="(() => currentPage++)">Next</button>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<ForecastItem> forecasts = new();
    private bool isLoading = true;
    private string searchTerm = "";
    private int currentPage = 1;
    private int pageSize = 30;
    private bool sortAscending = true;

    // --- LOGIC FOR FILTERING, SORTING, AND PAGING ---
    private IEnumerable<ForecastItem> FilteredForecasts => forecasts
        .Where(x => string.IsNullOrWhiteSpace(searchTerm) || x.Status.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ForecastItem> PagedForecasts => FilteredForecasts
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private int TotalPages => (int)Math.Ceiling((double)FilteredForecasts.Count() / pageSize);

    protected override async Task OnInitializedAsync()
    {
        var client = ClientFactory.CreateClient("API");
        try { forecasts = await client.GetFromJsonAsync<List<ForecastItem>>("api/dashboard/history") ?? new(); }
        catch { }
        finally { isLoading = false; }
    }

    private void Sort(string column)
    {
        if (column == "Date") forecasts = sortAscending ? forecasts.OrderBy(x => x.ForecastDate).ToList() : forecasts.OrderByDescending(x => x.ForecastDate).ToList();
        if (column == "Guests") forecasts = sortAscending ? forecasts.OrderBy(x => x.OccupancyCount).ToList() : forecasts.OrderByDescending(x => x.OccupancyCount).ToList();
        sortAscending = !sortAscending;
    }

    private string GetBadgeClass(string status) => status.Contains("High") ? "badge-high" : status.Contains("Normal") ? "badge-normal" : "badge-low";
    private void ViewRoster(DateTime date) => NavManager.NavigateTo($"/roster?date={date.ToString("yyyy-MM-dd")}");

    public class ForecastItem
    {
        public DateTime ForecastDate { get; set; }
        public int OccupancyCount { get; set; }
        public string Status { get; set; }
    }
}