@page "/analytics"
@using HotelManagementSystem_weapp.Data
@using HotelManagementSystem_weapp.Models
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark">Business Intelligence Dashboard</h2>
        <p class="text-muted">Staffing efficiency analysis for Hotel Pro RMS</p>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Processing Analytics Data...</p>
        </div>
    }
    else if (metrics == null || !metrics.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> No data found for analysis.
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-4">
                    <small class="text-uppercase fw-bold text-muted">Avg. Occupancy</small>
                    <h2 class="fw-bold text-primary">@metrics.Average(m => m.ForecastedOccupancy).ToString("N0")</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-4 border-start border-success border-5">
                    <small class="text-uppercase fw-bold text-muted">Total Labor Cost</small>
                    <h2 class="fw-bold text-success">@metrics.Sum(m => m.EstimatedLaborCost).ToString("C2")</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm p-4">
                    <small class="text-uppercase fw-bold text-muted">Efficiency (Hrs/Guest)</small>
                    <h2 class="fw-bold text-dark">@metrics.Average(m => m.EfficiencyRatio).ToString("F2")</h2>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light small text-muted">
                        <tr>
                            <th class="ps-4">DATE</th>
                            <th>OCCUPANCY</th>
                            <th>STAFFING</th>
                            <th>LABOR COST</th>
                            <th class="text-end pe-4">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in metrics)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@m.Date.ToShortDateString()</td>
                                <td>@m.ForecastedOccupancy Guests</td>
                                <td>@m.ScheduledStaffCount Staff (@m.TotalStaffHours.ToString("F1") hrs)</td>
                                <td class="fw-bold text-dark">@m.EstimatedLaborCost.ToString("C2")</td>
                                <td class="text-end pe-4">
                                    <span class="@m.StatusClass">@m.Status</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private List<AnalyticsMetric> metrics = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAnalyticsAsync();
    }

    private async Task LoadAnalyticsAsync()
    {
        isLoading = true;
        try
        {
            using var db = await DbFactory.CreateDbContextAsync();

            // 1. Efficient data loading using AsNoTracking
            var forecasts = await db.Forecasts.AsNoTracking().OrderBy(f => f.ForecastDate).ToListAsync();
            var shifts = await db.Shifts.AsNoTracking().Include(s => s.Staff).ToListAsync();

            // 2. Data transformation (Select)
            metrics = forecasts.Select(f =>
            {
                var dailyShifts = shifts.Where(s => s.ShiftDate.Date == f.ForecastDate.Date).ToList();
                var totalHours = dailyShifts.Sum(s => (s.EndTime - s.StartTime).TotalHours);

                return new AnalyticsMetric
                {
                    Date = f.ForecastDate,
                    ForecastedOccupancy = f.OccupancyCount,
                    ScheduledStaffCount = dailyShifts.Count,
                    TotalStaffHours = totalHours,
                    EstimatedLaborCost = (decimal)dailyShifts.Sum(s =>
                        (s.EndTime - s.StartTime).TotalHours * (double)(s.Staff?.HourlyRate ?? 0))
                };
            }).ToList();
        }
        finally
        {
            isLoading = false;
        }
    }
}